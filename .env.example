# Copy to .env and adjust. Every setting is optional; defaults match a local Ollama + Mistral 7B setup.

# Language model
JARVIS_LLM_PROVIDER=ollama
JARVIS_LLM_MODEL_NAME=mistral
JARVIS_LLM_BASE_URL=http://localhost:11434
JARVIS_LLM_CONTEXT_WINDOW_TOKENS=8192
JARVIS_LLM_TEMPERATURE=0.2

# Any OpenAI-compatible server instead of Ollama (LM Studio, vLLM, llama.cpp server, OpenAI):
# JARVIS_LLM_PROVIDER=openai_compatible
# JARVIS_LLM_BASE_URL=http://localhost:1234/v1
# JARVIS_LLM_MODEL_NAME=mistral-7b-instruct
# JARVIS_LLM_API_KEY=

# Retrieval
JARVIS_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
JARVIS_RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
JARVIS_RERANKER_ENABLED=true
JARVIS_RETRIEVAL_CANDIDATE_COUNT=20
JARVIS_CONTEXT_DOCUMENT_COUNT=5

# API
JARVIS_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_AS_JSON=false

# Observability (optional Langfuse export, install with: pip install -e ".[langfuse]")
JARVIS_LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3000
